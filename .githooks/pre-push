#!/bin/sh
# Shared pre-push hook: the static analyzers, then the suite in RELEASE, before publishing.
#
# Enable once per clone:   git config core.hooksPath .githooks
#
# Release is what ships and what the optimizer can break, and it needs testability stated explicitly, so
# this is not a plain `swift test`. The scratch path is fixed so the release build is reused between pushes.
# The analyzers come first: they read source and finish in well under a second.
#
# A push that changes only workflow, documentation or analyzer configuration cannot change what the suite
# tests, so it skips the release run (the analyzers still run). The range is what git is about to send.
set -e

echo "pre-push: Scripts/analyzers.sh"
Scripts/analyzers.sh

zero=0000000000000000000000000000000000000000
code_changed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # deleting a ref
    if [ "$remote_sha" = "$zero" ]; then
        base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "")
    else
        base=$remote_sha
    fi
    if [ -z "$base" ]; then code_changed=1; continue; fi
    if git diff --name-only "$base" "$local_sha" \
        | grep -vE '^(\.github/|\.githooks/|CONTRIBUTING\.md$|README\.md$|LICENSE$|Scripts/analyzers\.sh$|\.dolly-baseline\.json$|\.deadwood\.json$)' \
        | grep -q .; then
        code_changed=1
    fi
done

if [ "$code_changed" -eq 0 ]; then
    echo "pre-push: only workflows, docs and analyzer configuration changed; skipping the release run"
    exit 0
fi
echo "pre-push: swift test -c release --enable-testable-imports"
swift test -c release --enable-testable-imports \
    --scratch-path "${AEMIJSON_RELEASE_SCRATCH:-$HOME/Library/Caches/aemijson/release-build}"
